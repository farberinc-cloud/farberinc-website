# Farber.Inc Chat — environment variables
#
# Copy this file to `.env` (same folder) and fill in real values.
# .env is BLOCKED from web access by .htaccess and EXCLUDED from git by .gitignore.
#
# Required: your MiniMax Subscription Key (sk-cp-…)
MINIMAX_API_KEY=sk-cp-your-key-here

# Optional: override these only if you know why
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_MODEL=MiniMax-M3

# Optional: lead notifications
# LEAD_WEBHOOK_URL=https://hooks.slack.com/services/...
# LEAD_EMAIL_TO=you@youremail.com
# LEAD_EMAIL_FROM=wordpress@yourdomain.com

# Optional: set to 1 to return extra debug info in API errors (don't enable in production)
# CHAT_DEBUG=0
